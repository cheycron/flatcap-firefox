{
  "manifest_version": 3,
  "version": "2.0.0",
  "name": "Flatcap",
  "description": "Quiet precision for Firefox. Flatcap Slate in dark mode and Flatcap Daylight in light mode, following your system.",
  "author": "Cheycron Blaine",
  "homepage_url": "https://github.com/cheycron/flatcap-firefox",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flatcap-theme@cheycron.com",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#F3F5F7",
      "frame_inactive": "#F3F5F7",
      "tab_background_text": "#465463",
      "tab_text": "#28313B",
      "tab_selected": "#FAFBFC",
      "tab_line": "#285D85",
      "tab_loading": "#285D85",
      "toolbar": "#FAFBFC",
      "toolbar_text": "#28313B",
      "icons": "#465463",
      "icons_attention": "#285D85",
      "button_background_hover": "#E6EBF0",
      "button_background_active": "#DCE9F4",
      "toolbar_top_separator": "#D2D9E0",
      "toolbar_bottom_separator": "#D2D9E0",
      "toolbar_vertical_separator": "#D2D9E0",
      "toolbar_field": "#F3F5F7",
      "toolbar_field_text": "#28313B",
      "toolbar_field_border": "#6C7A89",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#28313B",
      "toolbar_field_border_focus": "#285D85",
      "toolbar_field_highlight": "#C8DDF0",
      "toolbar_field_highlight_text": "#28313B",
      "popup": "#FFFFFF",
      "popup_text": "#28313B",
      "popup_border": "#D2D9E0",
      "popup_highlight": "#DCE9F4",
      "popup_highlight_text": "#28313B",
      "sidebar": "#FAFBFC",
      "sidebar_text": "#28313B",
      "sidebar_border": "#D2D9E0",
      "sidebar_highlight": "#DCE9F4",
      "sidebar_highlight_text": "#28313B",
      "ntp_background": "#F3F5F7",
      "ntp_text": "#28313B",
      "ntp_card_background": "#FAFBFC"
    },
    "properties": {
      "color_scheme": "light"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#191D22",
      "frame_inactive": "#191D22",
      "tab_background_text": "#AEB8C4",
      "tab_text": "#D5DBE3",
      "tab_selected": "#20252B",
      "tab_line": "#9BBFDF",
      "tab_loading": "#9BBFDF",
      "toolbar": "#20252B",
      "toolbar_text": "#D5DBE3",
      "icons": "#AEB8C4",
      "icons_attention": "#9BBFDF",
      "button_background_hover": "#323A43",
      "button_background_active": "#263E53",
      "toolbar_top_separator": "#3D4652",
      "toolbar_bottom_separator": "#3D4652",
      "toolbar_vertical_separator": "#3D4652",
      "toolbar_field": "#191D22",
      "toolbar_field_text": "#D5DBE3",
      "toolbar_field_border": "#8593A5",
      "toolbar_field_focus": "#292F36",
      "toolbar_field_text_focus": "#D5DBE3",
      "toolbar_field_border_focus": "#B0D2F0",
      "toolbar_field_highlight": "#3C546B",
      "toolbar_field_highlight_text": "#D5DBE3",
      "popup": "#292F36",
      "popup_text": "#D5DBE3",
      "popup_border": "#3D4652",
      "popup_highlight": "#263E53",
      "popup_highlight_text": "#D5DBE3",
      "sidebar": "#20252B",
      "sidebar_text": "#D5DBE3",
      "sidebar_border": "#3D4652",
      "sidebar_highlight": "#263E53",
      "sidebar_highlight_text": "#D5DBE3",
      "ntp_background": "#191D22",
      "ntp_text": "#D5DBE3",
      "ntp_card_background": "#20252B"
    },
    "properties": {
      "color_scheme": "dark"
    }
  }
}
